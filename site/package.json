{
  "name": "plex-poster-set-helper-2-site",
  "private": true,
  "version": "1.0.0",
  "description": "Project website for Plex Poster Set Helper 2, published to GitHub Pages",
  "type": "module",
  "scripts": {
    "release-data": "node scripts/release-data.mjs",
    "predev": "npm run release-data",
